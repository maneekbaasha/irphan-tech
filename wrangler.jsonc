{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irphan-tech",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
